{
  "name": "prina-core",
  "version": "0.2.1",
  "packageManager": "pnpm@9.15.9",
  "private": true,
  "description": "Prina unified content hub — content engine + API + MCP server",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:db": "tsx scripts/dev-db.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src packages",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1104.0",
    "@aws-sdk/s3-request-presigner": "^3.1104.0",
    "@fastify/static": "^8.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@prina/shared": "workspace:*",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.0",
    "drizzle-orm": "^0.44.0",
    "exifr": "^7.1.3",
    "fastify": "^5.0.0",
    "image-size": "^2.0.2",
    "liquidjs": "^10.28.0",
    "parse5": "^8.0.1",
    "pg": "^8.13.0",
    "pino": "^9.0.0",
    "prosemirror-model": "^1.24.0",
    "sharp": "^0.35.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/pg": "^8.11.0",
    "drizzle-kit": "^0.31.0",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
