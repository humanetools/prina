# prina-core 환경변수 — 민감 정보는 절대 커밋하지 말 것
DATABASE_URL=postgres://postgres:postgres@localhost:5433/prina
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Admin 빌드 산출물 경로 (로컬 개발: ../prina-admin/dist)
ADMIN_DIST_PATH=../prina-admin/dist

# S3 호환 스토리지 (Phase 4)
#S3_ENDPOINT=http://localhost:9000
#S3_BUCKET=prina-assets
#S3_ACCESS_KEY=
#S3_SECRET_KEY=

# imgproxy (Phase 4)
#IMGPROXY_URL=http://localhost:8080
#IMGPROXY_KEY=
#IMGPROXY_SALT=

# 라이선스 (T8.2) — 미설정 시 unlicensed 표출만 (차단 없음). URL 미설정 = 폐쇄망 모드
#LICENSE_KEY=
#LICENSE_SERVER_URL=
#LICENSE_GRACE_DAYS=14

# 화이트라벨 (T8.5) — 미설정 시 Prina 기본 브랜딩
#BRAND_NAME=Acme
#BRAND_LOGO_URL=https://cdn.acme.example.com/logo.svg
#BRAND_THEME={"light":{"--accent":"#2563eb"},"dark":{"--accent":"#60a5fa"}}
